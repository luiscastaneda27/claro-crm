            "flowType": "=IF(PurchaseType=='POR'&&ProductType=='SIM Card', 'POR', IF(PurchaseType=='ACT'&& ProductType=='SIM Card', 'LINEA_NUEVA', IF(PurchaseType=='ATT' && hasESIM == false, 'KIT', IF(ProductType=='Handset' && ( PurchaseType=='NAP' || (hasESIM == true && PurchaseType=='ATT' )), 'TERM_LIBRE', IF(ProductType=='Tech' && ( PurchaseType=='NAP' || (hasESIM == true && PurchaseType=='ATT' )), 'TEC', ''))))",
