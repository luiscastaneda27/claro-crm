            "PortabilidadBloqueada": "=IF(%DataRaptorResult:OrderDeliveryStatus% == \"PortabilityBlocked\" AND %DataRaptorResult:PurchaseType% == \"POR\", true, false)",
            "RecaudoManual": "=IF(%DataRaptorResult:Status% == 'InPayment' && %DataRaptorResult:OrderPaymentMethod% == 'Sistemas de Recaudo en el Aliado', true, false)",
            "RechazoABD": "=IF((%DataRaptorResult:OMOrderStatus% == \"Superseded\" AND %DataRaptorResult:PurchaseType% == \"POR\" AND %DataRaptorResult:CancelReasonCode% != \"5001\") OR %DataRaptorResult:ClosingReason% == \"Duplicada por Retoma de Portabilidad\", true, false)",
