            "RenewPortaFlag": "%DataRaptorResult:RenewPortaFlag%",
            "ShowRenewPortaABD": "=IF(%DataRaptorResult:PurchaseType% == \"POR\" && (%DataRaptorResult:ClosingReason% == \"Duplicada por Retoma de Portabilidad\" || %DataRaptorResult:CancelReasonCode% == \"5001\"),false,IF(%DataRaptorResult:PurchaseType% == \"POR\" && %DataRaptorResult:Status% == \"Cerrada Perdida\" && %DataRaptorResult:OMOrderStatus% == \"Superseded\",true,false))",
            "ShowRenewPortaDesk": "=IF(%DataRaptorResult:PurchaseType% == \"POR\" && %DataRaptorResult:Status% == \"DeliveryAndActivated\" && %DataRaptorResult:OrderDeliveryStatus% == \"PortabilityBlocked\" && %DataRaptorResult:DeliveryMethod% == \"Delivery\", true, false)",
