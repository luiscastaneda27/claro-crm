                "ApellidoTercero": "=IF(%radicacionStep2:TerceroBlock:ApellidoTercero% <> null, %radicacionStep2:TerceroBlock:ApellidoTercero%, '')",
                "Asunto": "%radicacionStep2:AsuntoRecursoNew%",
                "CanalAtencion": "=IF(%UserData|1:FVU_Canal__c% <> 'SF_TMK', 'CAV', 'MKT')",
                "Cun": "%caseInfo:OriginalCase|1:PVU_CUN__c%",
                "Descripcion": "%radicacionStep2:DescripcionCaso%",
