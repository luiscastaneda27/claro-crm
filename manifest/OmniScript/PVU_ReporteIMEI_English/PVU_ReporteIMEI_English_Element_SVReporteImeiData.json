            "fechaInicioSusp": "=CONCATENATE(YEAR(TODAY()),'-',IF(MONTH(TODAY())< 10, CONCATENATE(0,MONTH(TODAY())), MONTH(TODAY())), '-',IF(DAYOFMONTH(TODAY())< 10, CONCATENATE(0,DAYOFMONTH(TODAY())), DAYOFMONTH(TODAY())))",
            "fiscalia": "=IF(%ReporteImei:ReporteFiscalia:CompartirFiscalia% == 'Si','1','0')",
            "idCuenta": "%AccountId%",
            "idUsuario": "%userId%",
            "imeiInput": "%imeiFromContext%",
            "marcaInput": "%marcaFromContext%",
            "menorEdad": "=IF(%ReporteImei:ReporteFiscalia:VictimaMenor% != null, IF(%ReporteImei:ReporteFiscalia:VictimaMenor% == 'Si', '1', '0'), '0')",
            "minInput": "%minFromContext%",
            "modeloInput": "%modeloFromContext%",
            "msisdnInput": "%msisdnFromContext%",
            "nombreReporteInput": "%ReporteImei:NombreYApellidos%",
            "numIdReporte": "%ReporteImei:NumeroDocReconocer%",
            "telContactoReporte": "%ReporteImei:Text7%",
            "tipoArma": "=IF(%ReporteImei:ReporteFiscalia:Arma% != null, '1', '0')",
            "tipoDocReporte": "%ReporteImei:TipoDocReconocer%",
            "tipoReporte": "=IF(%Motivo% == 1,1,2)",
            "tipoReporteAbd": "%ReporteImei:Motivo%"
