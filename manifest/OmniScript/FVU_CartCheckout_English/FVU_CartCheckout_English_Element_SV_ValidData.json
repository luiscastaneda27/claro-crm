            "ValidMethodOfDelivery": "=IF(%StepDeliveryMethod:SelectMethod%==\"Immediatepickup\",\"Entrega Inmediata\",IF(%StepDeliveryMethod:SelectMethod%==\"PickUp\",\"Retiro en Tienda\",IF(%StepDeliveryMethod:SelectMethod%==\"Delivery\",\"Entrega en Domicilio\",null)))",
            "ValidPhone": "=IF(OR(AND(%StepDeliveryMethod:SelectMethod% == \"PickUp\", %StepDeliveryMethod:AuthorizedPerson% == true), AND(%StepDeliveryMethod:SelectMethod% == \"Delivery\", %StepDeliveryMethod:AuthorizedPerson2% == true)), %StepDeliveryMethod:BlockAuthorizedPerson:Phone%, %Account:AccountPhone%)",
            "ValidReceives": "=IF(OR(AND(%StepDeliveryMethod:SelectMethod% == \"PickUp\", %StepDeliveryMethod:AuthorizedPerson% == true), AND(%StepDeliveryMethod:SelectMethod% == \"Delivery\", %StepDeliveryMethod:AuthorizedPerson2% == true)), %StepDeliveryMethod:BlockAuthorizedPerson:Name%, %Account:AccountName%)",
