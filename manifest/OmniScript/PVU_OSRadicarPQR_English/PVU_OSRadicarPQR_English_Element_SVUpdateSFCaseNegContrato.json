                "MedioNotificacionValor": "=IF(%Step2:MedioNotificacionElegidoClienteMail% <> null, %Step2:MedioNotificacionElegidoClienteMail%, IF(%Step2:MedioNotificacionElegidoClienteCorrespondencia% <> null, %Step2:MedioNotificacionElegidoClienteCorrespondencia%, IF(%Step2:MedioNotificacionElegidoClienteTelefonica% <> null, %Step2:MedioNotificacionElegidoClienteTelefonica%, IF(%UserData|1:FVU_Canal__c% == 'SF_TMK', %MedioNotificacionTelefono%,%MedioNotificacionMail%))))",
                "MedioRadicacion": "=IF(%UserData|1:FVU_Canal__c% == 'SF_TMK', %Step2:MedioRadicacionTMK%,%Step2:MedioRadicacionCAV%)",
                "NombreTercero": "=IF(%Step2:TerceroBlock:NombreTercero% <> null, %Step2:TerceroBlock:NombreTercero%, '')",
                "NumeroDocTercero": "=IF(%Step2:TerceroBlock:NumeroDocTercero% <> null, %Step2:TerceroBlock:NumeroDocTercero%, '')",
                "NumeroLinea": "=IF(%VozCliente% == 'Negación de contrato', %ServicioSelected|1:AssetMinNegContrato%, '')",
                "QuienRealiza": "%Step2:Radicador%",
                "Status": "=IF(%Step1:vozDeClienteQueja-Block:vozDeClienteQueja% == 'Queja de portación no solicitada' || %VozCliente% == 'Negación de contrato', 'En curso', 'Cerrado')",
                "SubEstado": "=IF(%VozCliente% == 'Negación de contrato', '-', '')",
                "TipoDocTercero": "=IF(%Step2:TerceroBlock:TipoDocTercero% <> null, %Step2:TerceroBlock:TipoDocTercero%, null)",
                "TipoPQR": "%Step1:PeticionQueja%",
                "ValoresReclamacion": "%Step2:ValoresReclamacion%"
            }
        },
