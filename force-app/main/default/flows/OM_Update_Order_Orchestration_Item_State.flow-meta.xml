<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>El flow ejecutará la clase, qué se encarga de obtener el error de los OIs del campo Response. Donde, se guardará ese error si el OI falló, de lo contrario actualizará la orden para borrar el error guardado previamente</description>
        <name>CortarExecutionLog</name>
        <label>CortarExecutionLog</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <actionName>OM_SplitStringFromFlow_cls</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>lstOrchItem</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputParameters>
        <nameSegment>OM_SplitStringFromFlow_cls</nameSegment>
        <outputParameters>
            <assignToReference>strExecutionLog</assignToReference>
            <name>output</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>23/07 Se dejá solo la ejecución del Action para invocar la Apex encargada de Limpiar/Almacenar los errores del OI en la Order</description>
    <environments>Default</environments>
    <interviewLabel>OM_Update_State_ {!$Flow.CurrentDateTime}</interviewLabel>
    <label>OM_Update_Order_Orchestration_Item_State</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CortarExecutionLog</targetReference>
        </connector>
        <filterLogic>(1 OR 2 OR 3) AND 4 AND 5</filterLogic>
        <filters>
            <field>vlocity_cmt__State__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </filters>
        <filters>
            <field>vlocity_cmt__State__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Fatally Failed</stringValue>
            </value>
        </filters>
        <filters>
            <field>vlocity_cmt__State__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>vlocity_cmt__Response__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>vlocity_cmt__OrchestrationItemType__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Callout</stringValue>
            </value>
        </filters>
        <object>vlocity_cmt__OrchestrationItem__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <description>Almacena el resultado que retorna la clase para obetener el ultimo log</description>
        <name>strExecutionLog</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
