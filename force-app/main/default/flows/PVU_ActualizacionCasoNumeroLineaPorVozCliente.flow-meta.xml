    <formulas>
        <name>AgregarSerialOImei</name>
        <dataType>String</dataType>
        <expression>IF( ISBLANK({!$Record.PVU_RelacionServiciosEquipos__c}), {!AgregaSerialOIMEI}, {!$Record.PVU_RelacionServiciosEquipos__c} &amp; &quot;, &quot; &amp;  {!AgregaSerialOIMEI})</expression>
    </formulas>
    <formulas>
        <name>NumeroTelefono</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE( SUBSTITUTE( {!ObtenerAsset.vlocity_cmt__AttributeSelectedValues__c}, &apos;{&quot;B2C-ATTR-MSISDN&quot;:&quot;&apos;, &apos;&apos; ), &apos;&quot;}&apos;, &apos;&apos; )</expression>
    </formulas>
    <formulas>
        <name>NumeroTelefonoOrderItem</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE( SUBSTITUTE( {!OrderItems.vlocity_cmt__AttributeSelectedValues__c} , &apos;{&quot;B2C-ATTR-MSISDN&quot;:&quot;&apos;, &apos;&apos; ), &apos;&quot;}&apos;, &apos;&apos; )</expression>
    </formulas>
    <formulas>
        <name>SubstituteSerialIMEI</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE({!AgregarSerialOImei}, &apos;[&apos;, &apos;&apos;), &apos;]&apos;, &apos;&apos;)</expression>
    </formulas>
