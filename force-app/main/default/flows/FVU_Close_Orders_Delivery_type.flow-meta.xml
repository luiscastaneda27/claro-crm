    <formulas>
        <name>AmountToPay</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Order.FVU_EffectiveOneTimeIncTaxesTotal__c} &lt; 0, &quot;(&quot;, &quot;&quot;) &amp; &quot;COP &quot; &amp; 
IF(ABS({!$Record.Order.FVU_EffectiveOneTimeIncTaxesTotal__c}) &gt;= 1000000000, TEXT(FLOOR(ABS({!$Record.Order.FVU_EffectiveOneTimeIncTaxesTotal__c}) / 1000000000)) &amp; &quot;.&quot;, &quot;&quot;) &amp;
IF(ABS({!$Record.Order.FVU_EffectiveOneTimeIncTaxesTotal__c}) &gt;= 1000000, RIGHT(TEXT(FLOOR(ABS({!$Record.Order.FVU_EffectiveOneTimeIncTaxesTotal__c}) / 1000000)), 3) &amp; &quot;.&quot;, &quot;&quot;) &amp; 
IF(ABS({!$Record.Order.FVU_EffectiveOneTimeIncTaxesTotal__c}) &gt;= 1000, RIGHT(TEXT(FLOOR(ABS({!$Record.Order.FVU_EffectiveOneTimeIncTaxesTotal__c}) / 1000)), 3) &amp; &quot;.&quot;, &quot;&quot;) &amp; RIGHT(TEXT(FLOOR(ABS({!$Record.Order.FVU_EffectiveOneTimeIncTaxesTotal__c}))), 3) &amp; IF({!$Record.Order.FVU_EffectiveOneTimeIncTaxesTotal__c}&lt; 0, &quot;)&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>RequestContentMail</name>
        <dataType>String</dataType>
        <expression>&quot;Estimado cliente, &lt;br&gt;&lt;br&gt; Claro le informa que su PIN de pago es el &quot;&amp; {!$Record.Order.FVU_CodigoPago__c} &amp;&quot; por valor de &quot;&amp;  {!AmountToPay} &amp;&quot; con fecha límite &quot;&amp; 
 TEXT( DAY( DATEVALUE({!$Record.Order.FVU_FechaVigencia__c}))) &amp;&quot;/&quot;&amp; TEXT( MONTH( DATEVALUE({!$Record.Order.FVU_FechaVigencia__c}))) &amp;&quot;/&quot;&amp;
 TEXT( YEAR( DATEVALUE({!$Record.Order.FVU_FechaVigencia__c}))) &amp;&quot;  &lt;a href=&apos;&quot;&amp; {!RequestPaymentURL} &amp;&quot;&apos;&gt;&quot;&amp; {!RequestPaymentURL} &amp;&quot;&lt;/a&gt;&quot;</expression>
    </formulas>
    <formulas>
        <name>RequestMessageType</name>
        <dataType>String</dataType>
        <expression>IF( {!SendSMS} &amp;&amp; {!SendEmail}, &quot;ToAll&quot;, IF({!SendSMS}, &quot;SMS&quot;, IF({!SendEmail},  &quot;SMTP&quot;, NULL)))</expression>
    </formulas>
    <formulas>
