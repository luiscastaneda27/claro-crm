<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Flujo para el registro de los campos del usuario que genera la orden.</description>
    <environments>Default</environments>
    <formulas>
        <name>CiudadCAV</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Owner:User.FVU_CiudadCAV__c} = &quot;&quot; || {!$Record.Owner:User.FVU_CiudadCAV__c} = &quot;TMK&quot;, &quot;TMK&quot;, {!$Record.Owner:User.FVU_CiudadCAV__c})</expression>
    </formulas>
    <formulas>
        <name>ShortName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Owner:User.FirstName} &amp; &quot; &quot; &amp; {!$Record.Owner:User.LastName}</expression>
    </formulas>
    <interviewLabel>Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FVU Update Order Owner Fields</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>UdateOrder</name>
        <label>UdateOrder</label>
        <locationX>561</locationX>
        <locationY>406</locationY>
        <inputAssignments>
            <field>FVU_BusinessChannel__c</field>
            <value>
                <elementReference>$Record.Owner:User.FVU_BusinessChannel__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FVU_Channel__c</field>
            <value>
                <elementReference>$Record.Owner:User.FVU_Canal__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FVU_CiudadCAVOrden__c</field>
            <value>
                <elementReference>CiudadCAV</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FVU_CodigoCAV__c</field>
            <value>
                <elementReference>$Record.Owner:User.FVU_CAV__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FVU_CodigoD__c</field>
            <value>
                <elementReference>$Record.Owner:User.FVU_CodigoD__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FVU_DaneCiudadCAVOrden__c</field>
            <value>
                <elementReference>$Record.Owner:User.FVU_DANE_Punto_de_Venta__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FVU_Short_Name__c</field>
            <value>
                <elementReference>ShortName</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>432</locationX>
        <locationY>56</locationY>
        <connector>
            <targetReference>UdateOrder</targetReference>
        </connector>
        <object>Order</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
