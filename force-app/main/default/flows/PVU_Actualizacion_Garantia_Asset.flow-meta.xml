<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Sub flujo para actualizar la fecha de vencimiento de garantía de un Asset al ingresar en un caso por falla de equipo en garantía. 
20250306: Se incluye este comentario para que este flujo sea desplegado y activado en producción.</description>
    <environments>Default</environments>
    <formulas>
        <name>Nueva_Fecha</name>
        <dataType>Date</dataType>
        <expression>{!Asset.PVU_FechaVencimientoGarantia__c} + {!Sumar_Dias}</expression>
    </formulas>
    <formulas>
        <name>Sumar_Dias</name>
        <dataType>Number</dataType>
        <expression>TODAY() - DATEVALUE({!$Record.CreatedDate})</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Actualizacion Garantia Asset {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PVU_Actualizacion_Garantia_Asset</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Asset</name>
        <label>Asset</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Asset</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AssetId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Asset</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Asset</name>
        <label>Update Asset</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>PVU_FechaVencimientoGarantia__c</field>
            <value>
                <elementReference>Nueva_Fecha</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Asset</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Asset</targetReference>
        </connector>
        <filterLogic>1 AND 4 AND (2 OR 3)</filterLogic>
        <filters>
            <field>PVU_Level3__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Falla de Equipo Garantia</stringValue>
            </value>
        </filters>
        <filters>
            <field>PVU_Codigo_de_Cierre__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Reparación Cambio de Equipo</stringValue>
            </value>
        </filters>
        <filters>
            <field>PVU_Codigo_de_Cierre__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Funcionamiento Correcto</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Cerrado</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
