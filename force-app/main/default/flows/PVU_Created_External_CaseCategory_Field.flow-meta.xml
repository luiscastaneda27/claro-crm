    <description>Ajuste para mejorar llave unica- Ajuste llave</description>
    <environments>Default</environments>
    <formulas>
        <name>Capacidadtotal</name>
        <dataType>Number</dataType>
        <expression>FLOOR((80-({!For_cantidad_Campo}+LEN({!CodigoCampos})))/3)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>CodigoCampos</name>
        <dataType>String</dataType>
        <expression>TEXT(LEN({!categoria}))&amp;TEXT(LEN({!subcategoria}))&amp;TEXT(LEN({!vozcliente}))&amp;TEXT(LEN({!LabelCampo}))</expression>
    </formulas>
    <formulas>
        <name>for_campo</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!LabelCampo}, &quot; &quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>For_cantidad_Campo</name>
        <dataType>Number</dataType>
        <expression>LEN({!for_campo})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>for_Categoria</name>
        <dataType>String</dataType>
        <expression>RIGHT(SUBSTITUTE({!categoria}, &quot; &quot;, &quot;&quot;),{!Capacidadtotal})</expression>
    </formulas>
    <formulas>
        <name>for_subcategoria</name>
        <dataType>String</dataType>
        <expression>RIGHT(SUBSTITUTE({!subcategoria}, &quot; &quot;, &quot;&quot;),{!Capacidadtotal})</expression>
    </formulas>
    <formulas>
        <name>for_voz_cliente</name>
        <dataType>String</dataType>
        <expression>LEFT(SUBSTITUTE({!vozcliente}, &quot; &quot;, &quot;&quot;),{!Capacidadtotal})</expression>
    </formulas>
