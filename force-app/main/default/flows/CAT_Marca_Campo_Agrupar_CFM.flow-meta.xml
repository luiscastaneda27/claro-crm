    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Consulta las promociones asociadas al order item que disparó el flujo</description>
        <name>Obtener_promociones_de_order_item</name>
        <label>Obtener promociones de order item</label>
        <locationX>380</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Almacenar_cantidad_de_Promociones</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>vlocity_cmt__OrderItemId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <object>vlocity_cmt__OrderAppliedPromotionItem__c</object>
        <outputReference>PromocionesDelOrderItem</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>vlocity_cmt__OrderAppliedPromotionId__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Actualizar_Agrupar_Factura_en_AddOn</name>
        <label>Actualizar Agrupar Factura en AddOn</label>
        <locationX>50</locationX>
        <locationY>1271</locationY>
        <connector>
            <targetReference>Actualizar_Agrupar_Factura_en_Plan</targetReference>
        </connector>
        <inputAssignments>
            <field>CAT_GroupCharges__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Actualiza el campo CAT_GroupCharges__c con true en el order item correspondiente al plan que está relacionado con el Add On que disparó el flujo</description>
        <name>Actualizar_Agrupar_Factura_en_Plan</name>
        <label>Actualizar Agrupar Factura en Plan</label>
        <locationX>50</locationX>
        <locationY>1379</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>vlocity_cmt__AssetReferenceId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.vlocity_cmt__ReliesOnItemId__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CAT_GroupCharges__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>OrderItem</object>
    </recordUpdates>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Leer_ReliesOn_ID</targetReference>
        </connector>
