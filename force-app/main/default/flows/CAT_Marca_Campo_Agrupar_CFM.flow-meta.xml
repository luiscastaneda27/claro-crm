            </value>
        </assignmentItems>
        <connector>
            <targetReference>Obtener_promociones_de_order_item</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Evalúa si alguna de las promociones asociadas al order item es de clase Bundle</description>
        <name>alguna_promocion_es_bundle</name>
        <label>Alguna Promoción es Bundle?</label>
        <locationX>182</locationX>
        <locationY>1163</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Alguna_promocion_si_es_Bundle</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ListadoDeClasesDeBeneficioPromociones</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Bundle</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Actualizar_Agrupar_Factura_en_AddOn</targetReference>
            </connector>
            <label>Si</label>
        </rules>
    </decisions>
    <decisions>
        <description>Se evalúa si el order item está asociado con una promoción aplicada a la orden</description>
        <name>Order_Item_tiene_promocion</name>
        <label>Order Item tiene promoción?</label>
        <locationX>380</locationX>
        <locationY>755</locationY>
        <defaultConnectorLabel>No tiene promociones asociadas</defaultConnectorLabel>
        <rules>
            <name>Si_tiene_promociones_asociadas</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CantidadPromociones</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Guardar_la_lista_de_OrderAppliedPromotion_IDs</targetReference>
            </connector>
            <label>Si tiene promociones asociadas</label>
        </rules>
    </decisions>
    <description>Este flujo marca el campo CAT_GroupCharges__c con true en los order items asociados a una promoción de clase Bundle cuando esta se agrega a una orden.</description>
    <environments>Default</environments>
    <interviewLabel>CAT Marca Campo Agrupar Factura {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CAT Marca Campo Agrupar CFM</label>
    <loops>
        <description>Hace un ciclo sobre las promociones asociadas a un Order Item y almacena una lista con los IDs de Order Applied Promotion que luego será utilizada para consultar información de las promociones.</description>
        <name>Guardar_la_lista_de_OrderAppliedPromotion_IDs</name>
        <label>Guardar la lista de OrderAppliedPromotion IDs</label>
        <locationX>182</locationX>
        <locationY>863</locationY>
        <collectionReference>PromocionesDelOrderItem</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Guardar_OrderAppliedPromotionIds</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>alguna_promocion_es_bundle</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
