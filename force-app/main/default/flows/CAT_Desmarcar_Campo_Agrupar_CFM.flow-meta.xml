        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OrderItem</objectType>
    </variables>
    <variables>
        <description>Almacena la lista de promociones asociadas a la misma orden donde se está borrando una promoción.</description>
        <name>PromocionesAsociadasAOrden</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>vlocity_cmt__OrderAppliedPromotion__c</objectType>
    </variables>
</Flow>
