        <name>ListadoOrderAppliedPromotionItems</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>vlocity_cmt__OrderAppliedPromotionItem__c</objectType>
    </variables>
    <variables>
