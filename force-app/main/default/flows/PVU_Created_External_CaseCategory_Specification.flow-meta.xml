            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>KeyName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>{!CodigoCampos}{!for_subcategoria}{!for_voz_cliente}</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>update_External_Key</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>Capacidadtotal</name>
        <dataType>Number</dataType>
        <expression>FLOOR((80-(LEN({!CodigoCampos})))/2)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CodigoCampos</name>
        <dataType>String</dataType>
        <expression>TEXT(LEN({!subcategoria}))&amp;TEXT(LEN({!vozcliente}))</expression>
    </formulas>
    <formulas>
        <name>for_campo</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!LabelCampo}, &quot; &quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>For_cantidad_Campo</name>
        <dataType>Number</dataType>
        <expression>LEN({!for_campo})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>for_subcategoria</name>
        <dataType>String</dataType>
        <expression>RIGHT(SUBSTITUTE({!subcategoria}, &quot; &quot;, &quot;&quot;),{!Capacidadtotal})</expression>
    </formulas>
    <formulas>
        <name>for_voz_cliente</name>
        <dataType>String</dataType>
        <expression>LEFT(SUBSTITUTE({!vozcliente}, &quot; &quot;, &quot;&quot;),{!Capacidadtotal})</expression>
    </formulas>
