    <decisions>
        <description>Verifica si el total con impuestos (precio plan móvil + precio paquete - ajuste de precio) es mayor al cupo de crédito que tenemos. De ser así , entonces el cupo disponible no es suficiente para agregar la promoción</description>
        <name>Excede_cupo_disponible_con_imp</name>
        <label>Excede cupo disponible?</label>
        <locationX>182</locationX>
        <locationY>2063</locationY>
        <defaultConnectorLabel>No excede cupo</defaultConnectorLabel>
        <rules>
            <name>Excede_cupo_con_imp</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>precioTotalConImpConPromo</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>cupoCredito</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Cupo_Excedido_con_imp</targetReference>
            </connector>
            <label>Excede cupo</label>
        </rules>
    </decisions>
