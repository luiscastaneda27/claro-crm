    <start>
        <locationX>320</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Obtener_productos_de_promoci_n</targetReference>
        </connector>
        <filterFormula>AND(
    ISPICKVAL({!$Record.vlocity_cmt__PromotionId__r.CAT_PromotionClass__c}, &apos;Bundle&apos;),
    NOT(ISBLANK(TEXT({!$Record.vlocity_cmt__OrderId__r.Type}))),
    NOT(
        OR(
            ISPICKVAL({!$Record.vlocity_cmt__OrderId__r.Type}, &apos;Cambios&apos;),
            ISPICKVAL({!$Record.vlocity_cmt__OrderId__r.Type}, &apos;Suspension&apos;),
            ISPICKVAL({!$Record.vlocity_cmt__OrderId__r.Type}, &apos;Cesion&apos;),
            ISPICKVAL({!$Record.vlocity_cmt__OrderId__r.Type}, &apos;Reactivacion&apos;),
            ISPICKVAL({!$Record.vlocity_cmt__OrderId__r.Type}, &apos;Cancelacion&apos;),
            ISPICKVAL({!$Record.vlocity_cmt__OrderId__r.Type}, &apos;Reinstalacion&apos;),
            ISPICKVAL({!$Record.vlocity_cmt__OrderId__r.Type}, &apos;Cambio SIM&apos;),
            ISPICKVAL({!$Record.vlocity_cmt__OrderId__r.Type}, &apos;Reconexion&apos;)
        )
    ),
    NOT(ISPICKVAL({!$Record.vlocity_cmt__OrderId__r.vlocity_cmt__SupplementalAction__c}, &apos;Cancel&apos;))
)</filterFormula>
        <object>vlocity_cmt__OrderAppliedPromotion__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
