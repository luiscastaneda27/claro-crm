            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.FVU_BusinessChannel__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>CAV</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_CAV_Retriever</targetReference>
            </connector>
            <label>CAV</label>
        </rules>
    </decisions>
