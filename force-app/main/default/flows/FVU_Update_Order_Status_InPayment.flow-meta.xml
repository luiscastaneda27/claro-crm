    <decisions>
        <name>StatusUpdate</name>
        <label>StatusUpdate</label>
        <locationX>768</locationX>
        <locationY>423</locationY>
        <defaultConnectorLabel>Resultado predeterminado</defaultConnectorLabel>
        <rules>
            <name>AssignarSerial</name>
            <conditionLogic>1 OR 2 OR 3 OR 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FVU_ProductDeliveryStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AssignSerial</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CAT_ProductType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>eSIM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Order.FVU_PurchaseType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MIG</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FVU_ProductDeliveryStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>assignedSerial</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_and_Send_PinLink</targetReference>
            </connector>
            <label>AssignarSerial</label>
        </rules>
        <rules>
            <name>SinInventario</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FVU_ProductDeliveryStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OutOfStock</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateOrder</targetReference>
            </connector>
            <label>SinInventario</label>
        </rules>
    </decisions>
