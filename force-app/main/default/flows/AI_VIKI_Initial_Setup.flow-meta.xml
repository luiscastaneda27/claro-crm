    <description>Crear Agentforce Session.
Ación que debe ser invocada siempre en el inicio del flujo, único y obligatorio, que vas a buscar el Número de Cliente y la Biblioteca de Búsqueda RAG.</description>
    <environments>Default</environments>
    <formulas>
        <name>currentRecordIdIsValidId</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    REGEX({!currentRecordId}, &quot;[a-zA-Z0-9]{18}&quot; ),    
    REGEX( {!currentRecordId}, &quot;[a-zA-Z0-9]{15}&quot; )
)</expression>
    </formulas>
