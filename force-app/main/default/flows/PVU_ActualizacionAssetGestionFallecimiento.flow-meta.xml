<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>HU - 634399 Marcación crédito por fallecimiento. Flujo que actualiza el asset relacionado a un caso por fallecimiento del cliente</description>
    <environments>Default</environments>
    <interviewLabel>PVU_ActualizacionAssetRelacionado {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PVU_ActualizacionAssetGestionFallecimiento</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Obtengo mensaje del codigo de error PVU 006 &quot;Crédito cliente fallecido&quot;</description>
        <name>CustomMessageMDT</name>
        <label>CustomMessageMDT</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>UpdateAssetRelacionado</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Message_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PVU006</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>FIN_CustomMessages__mdt</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Message__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Actualizo Asset relacionado al caso con el mensaje &quot;Crédito cliente fallecido&quot; obtenido del metadato FIN_CustomMessages__mdt</description>
        <name>UpdateAssetRelacionado</name>
        <label>UpdateAssetRelacionado</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AssetId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PVU_GestionPorFallecimiento__c</field>
            <value>
                <elementReference>CustomMessageMDT.Message__c</elementReference>
            </value>
        </inputAssignments>
        <object>Asset</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CustomMessageMDT</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PVU_Level3__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Gestión por Fallecimiento</stringValue>
            </value>
        </filters>
        <filters>
            <field>PVU_Codigo_de_Cierre__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Marcación Exitosa</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
