<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <description>Muestra el mensaje de error de precio de cupo disponible excedido</description>
        <name>Error_Precio_Excede_Cupo_Disponible</name>
        <label>Error Precio Excede Cupo Disponible</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <customErrorMessages>
            <errorMessage>El precio del producto seleccionado supera el cupo disponible del cliente. Por favor seleccione un producto de menor valor.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <description>Compara el campo del precio de venta con impuestos del QuoteLineItem con el cupo de crédito asociado a la Quote.</description>
        <name>Precio_de_Venta_Excede_Cupo_Disponible</name>
        <label>Precio de Venta Excede Cupo Disponible?</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>No excede</defaultConnectorLabel>
        <rules>
            <name>Si_excede</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Obtener_Precio_Con_Impuestos.FVU_EffectiveOneTimeTotalIncTaxes__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Obtener_Cupo_de_Credito_Asociado_a_la_Quote.FIN_CreditQuota__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Precio_Excede_Cupo_Disponible</targetReference>
            </connector>
            <label>Sí excede</label>
        </rules>
    </decisions>
    <description>Flujo sobre el objeto QuoteLineItem que valida que el precio total del producto con impuestos no exceda el cupo disponible del cliente antes de agregarlo al carrito.</description>
    <environments>Default</environments>
    <interviewLabel>CAT Cupo Disponible Quote {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CAT Cupo Disponible Quote</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Consulta el cupo de crédito asociado a la Quote</description>
        <name>Obtener_Cupo_de_Credito_Asociado_a_la_Quote</name>
        <label>Obtener Cupo de Crédito Asociado a la Quote</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Precio_de_Venta_Excede_Cupo_Disponible</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.QuoteId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>FIN_CreditQuota__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Consulta el precio de venta con impuestos incluidos del QuoteLineItem que disparó el flujo</description>
        <name>Obtener_Precio_Con_Impuestos</name>
        <label>Obtener Precio Con Impuestos</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Obtener_Cupo_de_Credito_Asociado_a_la_Quote</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>QuoteLineItem</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>FVU_EffectiveOneTimeTotalIncTaxes__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Obtener_Precio_Con_Impuestos</targetReference>
        </connector>
        <filterFormula>ISPICKVAL({!$Record.Product2.vlocity_cmt__Type__c}, &apos;Tech&apos;) || ISPICKVAL({!$Record.Product2.vlocity_cmt__Type__c}, &apos;Handset&apos;)</filterFormula>
        <object>QuoteLineItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
