        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue>Exitoso</stringValue>
        </value>
    </variables>
    <variables>
        <description>La evaluación de la satisfacción del cliente con la respuesta o solución proporcionada, analizada por el agente a partir del contexto de la conversación. Positivo/Neutro/Negativo</description>
        <name>Sentiment</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
