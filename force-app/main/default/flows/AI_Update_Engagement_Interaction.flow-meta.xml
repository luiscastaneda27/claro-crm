<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Error_result</name>
        <label>Error result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>result</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Error al actualizar la interacción</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>SetEndDateTime</name>
        <label>SetEndDateTime</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>endDatetime</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>EngagementInteractionId_Is_an_Id</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>COMPLETED_STATUS</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Completado</stringValue>
        </value>
    </constants>
    <decisions>
        <name>EngagementInteractionId_Is_an_Id</name>
        <label>EngagementInteractionId Is an Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_EngagementInteraction_by_ExternalId</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, Is an ExternalId</defaultConnectorLabel>
        <rules>
            <name>Yes_Is_an_Id</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsAnId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_EngagementInteraction_by_Id</targetReference>
            </connector>
            <label>Yes,  Is an Id</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsCompleted</name>
        <label>IsCompleted</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>EngagementInteractionId_Is_an_Id</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_IsCompleted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>COMPLETED_STATUS</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetEndDateTime</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Actualiza el registro de EngagementInteraction cuando el Agente IA provee una respuesta, con Id o con ExternalIdentifier</description>
    <environments>Default</environments>
    <formulas>
        <name>IsAnId</name>
        <dataType>Boolean</dataType>
        <expression>AND(LEFT({!EngagementInteractionId}, 3) == &quot;0u3&quot;, OR(LEN({!EngagementInteractionId}) = 15, LEN({!EngagementInteractionId}) = 18))</expression>
    </formulas>
    <interviewLabel>AI Update Engagement Interaction {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AI Update Engagement Interaction</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_EngagementInteraction_by_ExternalId</name>
        <label>Update EngagementInteraction by ExternalId</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Error_result</targetReference>
        </faultConnector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>ExternalIdentifier</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>EngagementInteractionId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AI_Action__c</field>
            <value>
                <elementReference>Action</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AI_Cause__c</field>
            <value>
                <elementReference>Cause</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AI_Sentiment_Detail__c</field>
            <value>
                <elementReference>SentimentDetail</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EndDateTime</field>
            <value>
                <elementReference>endDatetime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Reason</field>
            <value>
                <elementReference>Reason</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sentiment</field>
            <value>
                <elementReference>Sentiment</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>Status</elementReference>
            </value>
        </inputAssignments>
        <object>EngagementInteraction</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_EngagementInteraction_by_Id</name>
        <label>Update EngagementInteraction by Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Error_result</targetReference>
        </faultConnector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>EngagementInteractionId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AI_Action__c</field>
            <value>
                <elementReference>Action</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AI_Cause__c</field>
            <value>
                <elementReference>Cause</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AI_Sentiment_Detail__c</field>
            <value>
                <elementReference>SentimentDetail</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EndDateTime</field>
            <value>
                <elementReference>endDatetime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Reason</field>
            <value>
                <elementReference>Reason</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sentiment</field>
            <value>
                <elementReference>Sentiment</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>Status</elementReference>
            </value>
        </inputAssignments>
        <object>EngagementInteraction</object>
    </recordUpdates>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IsCompleted</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>La acción operativa que se registra al finalizar la interacción.</description>
        <name>Action</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Especifica que el motivo del cierre es que la consulta del cliente fue atendida con una solución.</description>
        <name>Cause</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>endDatetime</name>
        <dataType>DateTime</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Id del registro de EngagementInteraction</description>
        <name>EngagementInteractionId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Razón del contacto del engagement.</description>
        <name>Reason</name>
