     /**
     * Helper method to create test products and order items
     * @param testOrder Order to relate the items to
     * @return List<OrderItem> List of created order items
     */
    public static List<OrderItem> createTestProductsAndOrderItems(Order testOrder) {
        // Create three test products
        List<Product2> products = new List<Product2>{
            new Product2(
                Name = 'Product 1',
                ProductCode = 'PROD1',
                IsActive = true
            ),
            new Product2(
                Name = 'Bloqueo PS',
                ProductCode = 'B2C-MOB-POST-FUNC-y-BLOQ-PS',
                IsActive = true
            ),
            new Product2(
                Name = 'Product 3',
                ProductCode = 'PROD3',
                IsActive = true
            )
        };
        insert products;

        // Get the standard pricebook id
        Id pricebookId = Test.getStandardPricebookId();

        // Create PricebookEntries for the products
        List<PricebookEntry> pricebookEntries = new List<PricebookEntry>();
        for(Product2 prod : products) {
            pricebookEntries.add(new PricebookEntry(
                Pricebook2Id = pricebookId,
                Product2Id = prod.Id,
                UnitPrice = 100,
                IsActive = true
            ));
        }
        insert pricebookEntries;
      

        // Create assets for each product
        List<Asset> assets = new List<Asset>();
        for(Product2 prod : products) {
            assets.add(new Asset(
                Name = 'Test Asset ' + prod.Name,
                AccountId = testOrder.AccountId,
                Product2Id = prod.Id
            ));
        }
        insert assets;

        // Find the product and related entries for the Change action
        Product2 productForChange = [SELECT Id FROM Product2 WHERE ProductCode = 'B2C-MOB-POST-FUNC-y-BLOQ-PS' LIMIT 1];
        PricebookEntry pbeForChange = [SELECT Id FROM PricebookEntry WHERE Product2Id = :productForChange.Id LIMIT 1];
        Asset assetForChange = [SELECT Id FROM Asset WHERE Product2Id = :productForChange.Id LIMIT 1];

        // Create OrderItems
        List<OrderItem> orderItems = new List<OrderItem>{
            new OrderItem(
                OrderId = testOrder.Id,
                Product2Id = productForChange.Id,
                vlocity_cmt__Action__c = 'Change',
                vlocity_cmt__SubAction__c = 'ChangeSim-Modify',
                FVU_ReasonCode__c = '2032',
                vlocity_cmt__AssetId__c = assetForChange.Id,
                Quantity = 1,
                UnitPrice = 100,
                vlocity_cmt__LineNumber__c = '0029.0001.0001',
                PricebookEntryId = pbeForChange.Id
            ),
            new OrderItem(
                OrderId = testOrder.Id,
                Product2Id = products[0].Id,
                vlocity_cmt__Action__c = 'Existing',
                vlocity_cmt__SubAction__c = 'ChangeSim-Modify',
                FVU_ReasonCode__c = '2032',
                vlocity_cmt__AssetId__c = assets[0].Id,
                Quantity = 1,
                UnitPrice = 100,
                vlocity_cmt__LineNumber__c = '0029.0001',
                PricebookEntryId = pricebookEntries[0].Id
            ),
            new OrderItem(
                OrderId = testOrder.Id,
                Product2Id = products[2].Id,
                vlocity_cmt__Action__c = 'Existing',
                vlocity_cmt__SubAction__c = 'ChangeSim-Modify',
                FVU_ReasonCode__c = '2032',
                vlocity_cmt__AssetId__c = assets[2].Id,
                vlocity_cmt__ReliesOnItemId__c = 'b8f3886d-88c8-70d4-afbc-5226babb514d',
                Quantity = 1,
                UnitPrice = 100,
                vlocity_cmt__LineNumber__c = '0029.0001.0002',
                PricebookEntryId = pricebookEntries[2].Id
            )
        };
