    /**
    * Method to insert accounts & primary Contact for consumer
    */
    public static Map<String, String> createCustomer(){ 
        
        Account consumerAccount = new Account(Name = 'consumerAccount', RecordTypeId = consumerAccountRTId, Estado_del_Cliente__c = 'Al dia',
											FVU_BillingDetailFlag__c = false, FVU_DocumentType__c = 'PP', FVU_DocumentNumber__c = '1234567',
                                            Phone = '3196013097', OM_BSCSID__c = '12345', FVU_Email__c = 'xyz@salesforce.com' 
                                             );
        insert consumerAccount;
        
        Contact primaryContact = new Contact(firstName = 'test FirstName', LastName = 'test LastName',
                                             RecordTypeId = contactFVUConsumerRTId, AccountId = consumerAccount.Id
        						);
        insert primaryContact;
        
        consumerAccount.vlocity_cmt__PrimaryContactId__c = primaryContact.Id;
        update consumerAccount;
        
        Account billinAccount = new Account(Name = 'serviceAccount', RecordTypeId = billingAccountRTId,
											OM_BSCSID__c = '91000000057556', OM_BSCSIntID__c = '51986', vlocity_cmt__BillCycle__c = '',
                                            ParentId = consumerAccount.Id
                                           );
        insert billinAccount;
        
        
        Account serviceAccount = new Account(Name = 'serviceAccount', RecordTypeId = serviceAccountRTId, 
                                            FVU_ServiceState__c = 'BOGOTÁ', FVU_ServiceShortAddress__c = 'KR 1 70 35 AG A CS A', 
                                             FVU_ServiceMunicipality__c = 'BOGOTÁ, D.C.', FVU_ServiceDaneCode__c = '11001000', FVU_SerciveMerId__c = '15225541', 
                                             FVU_ServiceExtract__c = 6,FVU_AccountExternalID__c = '93000000058122', ParentId = consumerAccount.Id
                                            );
        insert serviceAccount;
        
        Map<String, String> insertedAccounts = new Map<String, String>();
        insertedAccounts.put('consumerAccount', consumerAccount.Id);
        insertedAccounts.put('billinAccount', billinAccount.Id);
        insertedAccounts.put('serviceAccount', serviceAccount.Id);
        insertedAccounts.put('primaryContact', primaryContact.Id);
        
        return insertedAccounts;
    }
    
