    @isTest static void executeItemSuccessReason7(){
        
        Id pricebookId = Test.getStandardPricebookId();
        Datetime dateNow = Datetime.NOW();
        Account testAccount = new Account(Name = 'Test Account');
        insert testAccount;
        
        ID idrtStandartOrder = Schema.SObjectType.order.getRecordTypeInfosByName().get('Standard Order').getRecordTypeId();
        
        contact testcontact = new contact(vlocity_cmt__MiddleName__c = 'rodolfo',LastName= 'paez',AccountId =  testAccount.Id);
        insert testcontact;
        
        vlocity_cmt__Subscription__c testsubscription = new vlocity_cmt__Subscription__c(OM_Contract__c='contac85',vlocity_cmt__SubscriptionNumber__c='testsuscr22',vlocity_cmt__ServiceAccountId__c=testAccount.id) ;
        insert testsubscription;
        
        Order testOrder = new Order(AccountId = testAccount.Id, status = 'Draft', EffectiveDate= Date.today(),Pricebook2Id = pricebookId, PVU_CaseInfo__c=' {"fechaInicioSusp":"2024-03-21","fechaFinSusp":"2024-03-25","Id":"500790000057EAvAAM"}',Type ='Suspension', FVU_OrderSubType__c='Temporal', RecordTypeId= idrtStandartOrder );
        insert testOrder;
        
        Asset testAsset = new Asset(Name ='navegala m 23',AccountId = testAccount.Id, contactId= testcontact.id );
        insert testAsset;

        Product2 productBase = new Product2();
        productBase.Family = 'CS/CD';
        productBase.ProductCode = 'OM_BASE';
        productBase.Name = 'Cambio';
        insert productBase;
        
        PricebookEntry pricebookentry = new PricebookEntry(UnitPrice = 0.0,IsActive = true, Pricebook2Id= pricebookId, Product2Id= productBase.id ) ;
        insert  pricebookentry;   
        
        OrderItem testOrderItem = new OrderItem( FVU_ReasonCode__c ='7' , OM_SubCausal__c = 'Temporal Voluntaria', vlocity_cmt__AssetId__c = testAsset.Id ,vlocity_cmt__SubscriptionId__c = testsubscription.Id, orderId =testOrder.Id, PricebookEntryId= pricebookentry.id,UnitPrice= 0.0,Quantity = 1 ) ; 
        insert testOrderItem;
        
        vlocity_cmt__OrchestrationPlan__c testOrchestrationPlan = new vlocity_cmt__OrchestrationPlan__c(vlocity_cmt__OrderId__c = testOrder.Id);
        insert testOrchestrationPlan;
        
        vlocity_cmt__OrchestrationItem__c testOrchestrationItem = new vlocity_cmt__OrchestrationItem__c(vlocity_cmt__OrchestrationPlanId__c = testOrchestrationPlan.Id, Name='ordenes futuras' ,vlocity_cmt__OrderItemId__c=testOrderItem.id  );
        insert testOrchestrationItem;
        
        OM_SubscriptionSuspInfo__c testSubscriptionSuspInf = new OM_SubscriptionSuspInfo__c(OM_OrderId__c= testorder.id, OM_Subscription__c= testsubscription.Id, OM_StatusEndDate__c=Date.valueOf(dateNow).addDays(60) );
        insert testSubscriptionSuspInf;

        
        List<OrderItem> oItemLst = [SELECT Id,vlocity_cmt__AttributeSelectedValues__c,
                                            FVU_ReasonCode__c,
                                            OM_SubCausal__c,
                                            vlocity_cmt__AssetId__c,
                                            vlocity_cmt__SubscriptionId__c,
                                            orderId
                                            from OrderItem ];
        
        
        
        List<vlocity_cmt__OrchestrationItem__c> itemsLst = [SELECT id,
                                                                vlocity_cmt__OrchestrationPlanId__r.vlocity_cmt__OrderId__c,
                                                                vlocity_cmt__OrchestrationPlanId__r.vlocity_cmt__OrderId__r.AccountId
                                                                FROM vlocity_cmt__OrchestrationItem__c 
                                                                ];
        
        OM_ManageFutureOrders FutureOrders = new OM_ManageFutureOrders();  
        Try{
            
            Test.startTest();
            FutureOrders.executeBatch(itemsLst);
            Test.stopTest();
            System.assert(true, 'shuldUpdateCase');
        }catch(Exception ex){
            
            System.assertEquals('Error generando orden futura. descripcion:Error', ex.getMessage());
        }
    }
    
